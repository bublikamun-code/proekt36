# The assistant proxy has no dependencies beyond Node itself, so the image is the runtime
# plus one file. It never publishes a port: nginx reaches it inside the compose network.
FROM node:22-alpine
WORKDIR /app
COPY tools/ai-proxy.mjs /app/tools/ai-proxy.mjs
RUN chown -R node:node /app
USER node
EXPOSE 8787
CMD ["node", "tools/ai-proxy.mjs"]
